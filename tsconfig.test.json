{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  // `exclude` is inherited, and the base config excludes `test`, which would
  // silently win over `include` and leave the tests unchecked.
  "exclude": ["node_modules", "dist"],
  // Everything that is not shipped but still has to compile: tests, the manual
  // smoke scripts and the eval harness. They are not in tsconfig.json because
  // that one builds `dist/`, but leaving them out of the typecheck entirely
  // meant a changed interface broke them silently.
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "*.config.ts",
    "drizzle.config.ts"
  ]
}
