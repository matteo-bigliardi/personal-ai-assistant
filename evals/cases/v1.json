        "expect": {
          "tool": "create_project",
          "args": {
            "name": "Cassini"
          }
        }
      }
    ]
  },
  {
    "id": "briefing-time-change",
    "area": "briefing",
    "steps": [
      {
        "message": "mandami il briefing alle 8:05",
        "expect": {
          "tool": "set_briefing_time",
          "args": {
            "time": "08:05"
          }
        }
      }
    ]
  },
  {
    "id": "unknown-capability-is-declined",
    "area": "boundaries",
    "note": "No tool covers this. Saying it plainly beats pretending, and beats calling something unrelated.",
    "steps": [
      {
        "message": "mandami una mail con il riepilogo",
        "expect": {
          "noTool": true
        }
      }
    ]
  }
]
