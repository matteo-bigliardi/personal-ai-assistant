# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3000
TZ=Europe/Rome

# --- Database ---
# For local dev via docker-compose the host is "postgres"; from host machine use "localhost".
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant

# --- Telegram ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM provider (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Google Calendar (added in Fase 4) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
