# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
HTTP_PORT=3000
TZ=Europe/Rome

# --- Database ---
# docker-compose reads these to provision Postgres. POSTGRES_PASSWORD has no
# default on purpose: compose refuses to start without it, so no deployment ever
# runs on a password published in this file. Generate one, e.g.
#   openssl rand -base64 24
POSTGRES_USER=assistant
POSTGRES_PASSWORD=
POSTGRES_DB=assistant

# Used by the app when running outside compose (npm run dev). Must match the
# three variables above. Percent-encode any of : / ? # [ ] @ in the password.
DATABASE_URL=postgres://assistant:CHANGE_ME@localhost:5432/assistant

# --- Telegram ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use the bot (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM provider (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Calendar (optional: leave both empty to run without calendar tools) ---
# A service account key, not an OAuth client. The calendar is shared with the
# service account's own address, so access never expires and needs no browser
# step. Keep the file out of git; .gitignore already covers credentials*.json.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# The calendar shared with the service account -- your own address, not
# "primary": a service account has a primary of its own, which is not yours.
GOOGLE_CALENDAR_ID=

# --- Audit ---
# How long tool-call and turn records are kept before the daily sweep drops
# them. The table stores argument names and types, never argument values.
AUDIT_RETENTION_DAYS=90
